---
import { Icon } from 'astro-icon/components';
const linkClass = "hover:text-primary transition-colors font-description";
---

<footer class="bg-secondary text-text py-10 pb-2 font-sans text-base">
  <div class="flex flex-wrap justify-between max-w-6xl mx-auto gap-8 md:gap-6 px-4">
    <div class="flex-1 min-w-50 mb-6">
      <h2 class="mb-4 font-title font-bold text-lg">CrochetByGenna</h2>
      <p class="mb-4 font-description leading-relaxed">Creating the cutest plushies and patterns, one stitch at a time. CrochetByGenna brings warmth and whimsy to life through handmade crochet plushies and patterns.</p>
      <div class="flex gap-3 mt-2">
        <a href="" aria-label="Instagram" class={linkClass}>
          <Icon name="mdi:instagram" width="20" height="20" />
        </a>
        <a href="" aria-label="TikTok" class={linkClass}>
          <Icon name="ic:baseline-tiktok" width="20" height="20" />
        </a>
        <a href="" aria-label="YouTube" class={linkClass}>
          <Icon name="mdi:youtube" width="20" height="20" />
        </a>
      </div>
    </div>
    <div class="flex-1 min-w-50 mb-6">
      <h3 class="mb-4 font-title font-bold">Shop</h3>
      <ul class="list-none p-0 m-0">
        <li class="mb-2"><a href="" class={linkClass}>All Products</a></li>
        <li class="mb-2"><a href="" class={linkClass}>Macaron Turtle Crochet Pattern</a></li>
        <li class="mb-2"><a href="" class={linkClass}>Patterns</a></li>
        <li class="mb-2"><a href="" class={linkClass}>Best Selling Patterns</a></li>
        <li class="mb-2"><a href="" class={linkClass}>About Us</a></li>
      </ul>
    </div>
    <div class="flex-1 min-w-50 mb-6">
      <h3 class="mb-4 font-title font-bold">Links</h3>
      <ul class="list-none p-0 m-0">
        <li class="mb-2"><a href="" class={linkClass}>Contact</a></li>
        <li class="mb-2"><a href="" class={linkClass}>Privacy Policy</a></li>
        <li class="mb-2"><a href="" class={linkClass}>Return & Refund Policy</a></li>
        <li class="mb-2"><a href="" class={linkClass}>Shipping Policy</a></li>
        <li class="mb-2"><a href="" class={linkClass}>Terms Of Service</a></li>
      </ul>
    </div>
    <div class="flex-1 min-w-50 mb-6">
      <h3 class="mb-4 font-title font-bold">Stay Connected!</h3>
      <p class="mb-4 font-description leading-relaxed">Join my newsletter for real time updates and crochet inspiration!</p>
    </div>
  </div>
  <div class="border-t border-primary text-left mt-6 pt-4 text-sm text-text px-4">
    <p>© 2026, Powered by Shopify</p>
  </div>
</footer>
