---
interface Slide {
  image: string;
  caption: string;
}

const defaultSlides: Slide[] = [
  {
    image: "/Home/HeroSlideshow/slide1.jpg",
    caption: "Welcome to EsheSite!",
  },
  {
    image: "/Home/HeroSlideshow/slide2.jpg",
    caption: "Discover our features",
  },
  {
    image: "/Home/HeroSlideshow/slide3.jpg",
    caption: "Join us today",
  },
  {
    image: "/Home/HeroSlideshow/slide2.jpg",
    caption: "Discover our features",
  },
];

const { slides = defaultSlides }: { slides?: Slide[] } = Astro.props;
---
<div id="hero-slideshow" class="relative w-full aspect-16/6 min-h-50 flex items-center justify-center overflow-hidden rounded-lg shadow-lg m-2.5 box-border max-w-[calc(100vw-20px)]" role="region" aria-roledescription="carousel" aria-label="Featured products slideshow">
  {slides.map((slide: Slide, idx: number) => (
    <div
      class={`absolute inset-0 transition-opacity duration-700 ${idx === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0'}`}
      data-slide={idx}
      aria-hidden={idx !== 0}
    >
      <img src={slide.image} alt="" class="w-full h-full object-cover" />
      <div class="absolute inset-0 flex items-end justify-center pb-12">
        <span class="text-white px-10 py-6 rounded font-title font-bold text-5xl md:text-7xl text-center drop-shadow-lg">
          {slide.caption}
        </span>
      </div>
    </div>
  ))}
  <div class="absolute top-4 right-4 z-20 flex gap-2">
    <button
      id="slideshow-toggle"
      type="button"
      class="rounded-full bg-secondary/90 px-3 py-2 text-sm font-bold text-white shadow focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-secondary"
      aria-pressed="false"
    >
      Pause slideshow
    </button>
  </div>
  <div id="slideshow-dots" class="absolute bottom-6 left-1/2 -translate-x-1/2 flex gap-3 z-20">
    {slides.map((_: Slide, idx: number) => (
      <button
        type="button"
        class="w-3 h-3 rounded-full border-2 border-white bg-white/60 hover:bg-white/90 transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-secondary"
        data-dot={idx}
        aria-label={`Go to slide ${idx + 1}`}
      ></button>
    ))}
  </div>
  </div>
<script type="module">
  const slideshow = document.getElementById('hero-slideshow');
  const toggleButton = document.getElementById('slideshow-toggle');
  const slides = slideshow.querySelectorAll('[data-slide]');
  const dots = document.querySelectorAll('#slideshow-dots [data-dot]');
  let current = 0;
  let interval = null;
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let isPaused = prefersReducedMotion.matches;

  function showSlide(idx) {
    slides.forEach((slide, i) => {
      if (i === idx) {
        slide.classList.add('opacity-100', 'z-10');
        slide.classList.remove('opacity-0', 'z-0');
        slide.setAttribute('aria-hidden', 'false');
      } else {
        slide.classList.remove('opacity-100', 'z-10');
        slide.classList.add('opacity-0', 'z-0');
        slide.setAttribute('aria-hidden', 'true');
      }
    });
    updateDots();
  }

  function updateDots() {
    dots.forEach((dot, i) => {
      if (i === current) {
        dot.classList.add('bg-white', 'border-primary', 'scale-110');
        dot.classList.remove('bg-white/60');
      } else {
        dot.classList.remove('bg-white', 'border-primary', 'scale-110');
        dot.classList.add('bg-white/60');
      }
    });
  }

  dots.forEach((dot, i) => {
    dot.addEventListener('click', () => {
      current = i;
      showSlide(current);
      resetInterval();
    });
  });

  function nextSlide() {
    current = (current + 1) % slides.length;
    showSlide(current);
  }

  function prevSlide() {
    current = (current - 1 + slides.length) % slides.length;
    showSlide(current);
  }

  function resetInterval() {
    clearInterval(interval);
    if (!isPaused) {
      interval = setInterval(nextSlide, 5000);
    }
  }

  function updateToggle() {
    if (!toggleButton) return;
    toggleButton.setAttribute('aria-pressed', String(isPaused));
    toggleButton.textContent = isPaused ? 'Play slideshow' : 'Pause slideshow';
  }

  updateDots();
  updateToggle();
  if (!isPaused) {
    interval = setInterval(nextSlide, 5000);
  }

  if (toggleButton) {
    toggleButton.addEventListener('click', () => {
      isPaused = !isPaused;
      updateToggle();
      resetInterval();
    });
  }

  prefersReducedMotion.addEventListener('change', () => {
    isPaused = prefersReducedMotion.matches;
    updateToggle();
    resetInterval();
  });
</script>
