---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Terms and Conditions | Life's Little Things">
  <section class="max-w-4xl mx-auto px-4 py-16 space-y-8 bg-background text-text">
    <header class="space-y-3">
      <h1 class="text-5xl font-title font-bold text-primary">Terms and Conditions</h1>
      <p class="text-lg">These terms govern use of the site and the sale of products from Life's Little Things.</p>
    </header>

    <section class="space-y-3">
      <h2 class="text-2xl font-title text-primary">Orders and Payment</h2>
      <p>Submitting an order does not guarantee acceptance. Orders are confirmed only after payment is authorized and inventory is available.</p>
    </section>

    <section class="space-y-3">
      <h2 class="text-2xl font-title text-primary">Product Variations</h2>
      <p>Handmade items may vary slightly in color, size, texture, and finish. These differences are part of the handmade nature of the products.</p>
    </section>

    <section class="space-y-3">
      <h2 class="text-2xl font-title text-primary">Limitation of Use</h2>
      <p>You agree not to misuse the website, attempt unauthorized access, or use site content without permission.</p>
    </section>
  </section>
</BaseLayout>