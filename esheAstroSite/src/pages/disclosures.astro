---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Business Disclosures | Life's Little Things">
  <section class="max-w-4xl mx-auto px-4 py-16 space-y-8 bg-background text-text">
    <header class="space-y-3">
      <h1 class="text-5xl font-title font-bold text-primary">Business Disclosures</h1>
      <p class="text-lg">This page provides the legal business identity and contact details for Life's Little Things.</p>
    </header>

    <section class="space-y-3">
      <h2 class="text-2xl font-title text-primary">Legal Business Name</h2>
      <p>Life's Little Things, a trade name of Eshe M. Snow.</p>
    </section>

    <section class="space-y-3">
      <h2 class="text-2xl font-title text-primary">Mailing Address</h2>
      <p>18 Newlyn Ln, Bella Vista, AR 72715</p>
    </section>

    <section class="space-y-3">
      <h2 class="text-2xl font-title text-primary">Contact Email</h2>
      <p><a class="text-primary hover:underline" href="mailto:lltcrafts22@gmail.com">lltcrafts22@gmail.com</a></p>
    </section>
  </section>
</BaseLayout>