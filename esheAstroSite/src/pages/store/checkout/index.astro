---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import {
  FREE_SHIPPING_THRESHOLD_CENTS,
  SHIPPING_FEE_CENTS,
} from "../../../lib/store/shipping";

const states = [
  { code: "AL", name: "Alabama" },
  { code: "AK", name: "Alaska" },
  { code: "AZ", name: "Arizona" },
  { code: "AR", name: "Arkansas" },
  { code: "CA", name: "California" },
  { code: "CO", name: "Colorado" },
  { code: "CT", name: "Connecticut" },
  { code: "DE", name: "Delaware" },
  { code: "DC", name: "District of Columbia" },
  { code: "FL", name: "Florida" },
  { code: "GA", name: "Georgia" },
  { code: "HI", name: "Hawaii" },
  { code: "ID", name: "Idaho" },
  { code: "IL", name: "Illinois" },
  { code: "IN", name: "Indiana" },
  { code: "IA", name: "Iowa" },
  { code: "KS", name: "Kansas" },
  { code: "KY", name: "Kentucky" },
  { code: "LA", name: "Louisiana" },
  { code: "ME", name: "Maine" },
  { code: "MD", name: "Maryland" },
  { code: "MA", name: "Massachusetts" },
  { code: "MI", name: "Michigan" },
  { code: "MN", name: "Minnesota" },
  { code: "MS", name: "Mississippi" },
  { code: "MO", name: "Missouri" },
  { code: "MT", name: "Montana" },
  { code: "NE", name: "Nebraska" },
  { code: "NV", name: "Nevada" },
  { code: "NH", name: "New Hampshire" },
  { code: "NJ", name: "New Jersey" },
  { code: "NM", name: "New Mexico" },
  { code: "NY", name: "New York" },
  { code: "NC", name: "North Carolina" },
  { code: "ND", name: "North Dakota" },
  { code: "OH", name: "Ohio" },
  { code: "OK", name: "Oklahoma" },
  { code: "OR", name: "Oregon" },
  { code: "PA", name: "Pennsylvania" },
  { code: "RI", name: "Rhode Island" },
  { code: "SC", name: "South Carolina" },
  { code: "SD", name: "South Dakota" },
  { code: "TN", name: "Tennessee" },
  { code: "TX", name: "Texas" },
  { code: "UT", name: "Utah" },
  { code: "VT", name: "Vermont" },
  { code: "VA", name: "Virginia" },
  { code: "WA", name: "Washington" },
  { code: "WV", name: "West Virginia" },
  { code: "WI", name: "Wisconsin" },
  { code: "WY", name: "Wyoming" }
];

const formatPrice = (cents: number) => `$${(cents / 100).toFixed(2)}`;
---

<BaseLayout title="Checkout - Shipping | Life's Little Things">
  <section
    class="my-12 px-4"
    data-shipping-fee={SHIPPING_FEE_CENTS}
    data-free-threshold={FREE_SHIPPING_THRESHOLD_CENTS}
  >
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-8">
        <h1 class="text-6xl font-title font-bold text-primary">Checkout</h1>
        <p class="text-text">Step 1 of 2: Shipping details</p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <form id="shipping-form" class="lg:col-span-2 bg-white rounded-lg shadow-lg p-6">
          <h2 class="text-3xl font-title text-primary mb-6">Shipping & Contact</h2>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <label class="block">
              <span class="text-sm font-bold text-primary">Full name</span>
              <input
                type="text"
                name="fullName"
                autocomplete="name"
                required
                class="mt-1 w-full border border-gray-300 rounded-lg px-4 py-2"
              />
            </label>
            <label class="block">
              <span class="text-sm font-bold text-primary">Email</span>
              <input
                type="email"
                name="email"
                autocomplete="email"
                required
                class="mt-1 w-full border border-gray-300 rounded-lg px-4 py-2"
              />
            </label>
            <label class="block">
              <span class="text-sm font-bold text-primary">Phone</span>
              <input
                type="tel"
                name="phone"
                autocomplete="tel"
                required
                class="mt-1 w-full border border-gray-300 rounded-lg px-4 py-2"
              />
            </label>
            <label class="block">
              <span class="text-sm font-bold text-primary">Address line 1</span>
              <input
                type="text"
                name="address1"
                autocomplete="address-line1"
                required
                class="mt-1 w-full border border-gray-300 rounded-lg px-4 py-2"
              />
            </label>
            <label class="block">
              <span class="text-sm font-bold text-primary">Address line 2</span>
              <input
                type="text"
                name="address2"
                autocomplete="address-line2"
                class="mt-1 w-full border border-gray-300 rounded-lg px-4 py-2"
              />
            </label>
            <label class="block">
              <span class="text-sm font-bold text-primary">City</span>
              <input
                type="text"
                name="city"
                autocomplete="address-level2"
                required
                class="mt-1 w-full border border-gray-300 rounded-lg px-4 py-2"
              />
            </label>
            <label class="block">
              <span class="text-sm font-bold text-primary">State</span>
              <select
                name="state"
                autocomplete="address-level1"
                required
                class="mt-1 w-full border border-gray-300 rounded-lg px-4 py-2"
              >
                <option value="">Select state</option>
                {states.map((state) => (
                  <option value={state.code}>{state.name}</option>
                ))}
              </select>
            </label>
            <label class="block">
              <span class="text-sm font-bold text-primary">ZIP code</span>
              <input
                type="text"
                name="postalCode"
                autocomplete="postal-code"
                inputmode="numeric"
                required
                class="mt-1 w-full border border-gray-300 rounded-lg px-4 py-2"
              />
            </label>
          </div>

          <label class="block mt-4">
            <span class="text-sm font-bold text-primary">Order notes (optional)</span>
            <textarea
              name="notes"
              rows={3}
              class="mt-1 w-full border border-gray-300 rounded-lg px-4 py-2"
            ></textarea>
          </label>

          <div class="mt-6 flex flex-col gap-2 text-sm text-gray-600">
            <p>US shipping only.</p>
            <p>
              Shipping is {formatPrice(SHIPPING_FEE_CENTS)} and free over {formatPrice(FREE_SHIPPING_THRESHOLD_CENTS)}.
            </p>
            <p>Taxes are calculated at payment based on your destination.</p>
          </div>

          <button
            id="continue-btn"
            type="submit"
            class="mt-6 w-full bg-primary text-white py-4 rounded-lg font-bold text-lg hover:bg-opacity-90 transition"
          >
            Continue to Payment
          </button>
        </form>

        <div id="order-summary" class="bg-white rounded-lg shadow-lg p-6">
          <h2 class="text-3xl font-title text-primary mb-6">Order Summary</h2>
          <p class="text-text">Loading your cart...</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  interface CartItem {
    itemId: string;
    variationId: string;
    name: string;
    priceCents: number;
    quantity: number;
  }

  const section = document.querySelector("section[data-shipping-fee]") as HTMLElement;
  const shippingFeeCents = Number(section.dataset.shippingFee || "0");
  const freeThresholdCents = Number(section.dataset.freeThreshold || "0");

  function getCart(): CartItem[] {
    const stored = localStorage.getItem("storeCart");
    if (!stored) return [];
    try {
      return JSON.parse(stored) as CartItem[];
    } catch {
      return [];
    }
  }

  function formatPrice(cents: number): string {
    return `$${(cents / 100).toFixed(2)}`;
  }

  function renderSummary(): void {
    const summary = document.getElementById("order-summary") as HTMLElement;
    const cart = getCart();
    const button = document.getElementById("continue-btn") as HTMLButtonElement;

    if (cart.length === 0) {
      summary.innerHTML = `
        <div class="text-center py-8">
          <p class="text-text mb-4">Your cart is empty.</p>
          <a href="/store" class="text-primary hover:underline">Browse the store</a>
        </div>
      `;
      button.disabled = true;
      button.classList.add("opacity-60", "cursor-not-allowed");
      return;
    }

    const subtotalCents = cart.reduce(
      (sum, item) => sum + item.priceCents * item.quantity,
      0
    );
    const shippingCents = subtotalCents >= freeThresholdCents ? 0 : shippingFeeCents;
    const estimatedTotal = subtotalCents + shippingCents;

    const itemsMarkup = cart
      .map(
        (item) => `
          <div class="flex justify-between text-sm">
            <span>${item.name} x${item.quantity}</span>
            <span>${formatPrice(item.priceCents * item.quantity)}</span>
          </div>
        `
      )
      .join("");

    summary.innerHTML = `
      <div class="space-y-3">
        ${itemsMarkup}
      </div>
      <div class="border-t mt-4 pt-4 space-y-2 text-sm">
        <div class="flex justify-between">
          <span>Subtotal</span>
          <span>${formatPrice(subtotalCents)}</span>
        </div>
        <div class="flex justify-between">
          <span>Shipping</span>
          <span>${shippingCents === 0 ? "Free" : formatPrice(shippingCents)}</span>
        </div>
        <div class="flex justify-between font-bold text-primary text-lg">
          <span>Estimated total</span>
          <span>${formatPrice(estimatedTotal)}</span>
        </div>
        <p class="text-xs text-gray-500">Taxes calculated at payment.</p>
      </div>
    `;
  }

  document.getElementById("shipping-form")?.addEventListener("submit", (event) => {
    event.preventDefault();
    const cart = getCart();
    if (cart.length === 0) return;

    const form = event.currentTarget as HTMLFormElement;
    const formData = new FormData(form);

    const shippingInfo = {
      fullName: String(formData.get("fullName") || ""),
      email: String(formData.get("email") || ""),
      phone: String(formData.get("phone") || ""),
      address1: String(formData.get("address1") || ""),
      address2: String(formData.get("address2") || ""),
      city: String(formData.get("city") || ""),
      state: String(formData.get("state") || ""),
      postalCode: String(formData.get("postalCode") || ""),
      country: "US",
      notes: String(formData.get("notes") || ""),
    };

    localStorage.setItem("checkoutShipping", JSON.stringify(shippingInfo));
    window.location.href = "/store/checkout/payment";
  });

  renderSummary();
</script>
