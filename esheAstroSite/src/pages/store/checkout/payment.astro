---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const appId = import.meta.env.PUBLIC_SQUARE_APPLICATION_ID ?? "";
const locationId = import.meta.env.PUBLIC_SQUARE_LOCATION_ID ?? "";
const squareEnv = import.meta.env.SQUARE_ENV === "production" ? "production" : "sandbox";
const squareScriptUrl =
  squareEnv === "production"
    ? "https://web.squarecdn.com/v1/square.js"
    : "https://sandbox.web.squarecdn.com/v1/square.js";
---

<BaseLayout title="Checkout - Payment | Life's Little Things">
  <script src={squareScriptUrl}></script>

  <section
    id="payment-section"
    class="my-12 px-4"
    data-app-id={appId}
    data-location-id={locationId}
  >
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-8">
        <h1 class="text-6xl font-title font-bold text-primary">Checkout</h1>
        <p class="text-text">Step 2 of 2: Payment</p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div class="lg:col-span-2 bg-white rounded-lg shadow-lg p-6">
          <h2 class="text-3xl font-title text-primary mb-6">Pay with Card</h2>

          <div id="payment-status" class="text-sm text-gray-500 mb-4"></div>
          <div id="payment-error" class="hidden text-sm text-red-600 mb-4"></div>

          <div id="card-container" class="border border-gray-300 rounded-lg p-4 mb-6"></div>

          <button
            id="pay-button"
            class="w-full bg-primary text-white py-4 rounded-lg font-bold text-lg hover:bg-opacity-90 transition"
            type="button"
          >
            Pay Now
          </button>

          <div class="mt-4 text-sm text-gray-500">
            Payments are processed securely by Square.
          </div>
        </div>

        <div id="order-summary" class="bg-white rounded-lg shadow-lg p-6">
          <h2 class="text-3xl font-title text-primary mb-6">Order Summary</h2>
          <p class="text-text">Loading order totals...</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  interface CartItem {
    itemId: string;
    variationId: string;
    name: string;
    priceCents: number;
    quantity: number;
  }

  interface ShippingInfo {
    fullName: string;
    email: string;
    phone: string;
    address1: string;
    address2?: string;
    city: string;
    state: string;
    postalCode: string;
    country: string;
    notes?: string;
  }

  interface OrderTotals {
    subtotalCents: number;
    shippingCents: number;
    taxCents: number;
    totalCents: number;
  }

  const section = document.getElementById("payment-section") as HTMLElement;
  const appId = section.dataset.appId || "";
  const locationId = section.dataset.locationId || "";
  const orderSummary = document.getElementById("order-summary") as HTMLElement;
  const payButton = document.getElementById("pay-button") as HTMLButtonElement;
  const errorEl = document.getElementById("payment-error") as HTMLElement;
  const statusEl = document.getElementById("payment-status") as HTMLElement;

  let card: any = null;
  let orderId = "";
  let totals: OrderTotals = {
    subtotalCents: 0,
    shippingCents: 0,
    taxCents: 0,
    totalCents: 0,
  };

  function getCart(): CartItem[] {
    const stored = localStorage.getItem("storeCart");
    if (!stored) return [];
    try {
      return JSON.parse(stored) as CartItem[];
    } catch {
      return [];
    }
  }

  function getShipping(): ShippingInfo | null {
    const stored = localStorage.getItem("checkoutShipping");
    if (!stored) return null;
    try {
      return JSON.parse(stored) as ShippingInfo;
    } catch {
      return null;
    }
  }

  function formatPrice(cents: number): string {
    return `$${(cents / 100).toFixed(2)}`;
  }

  function setStatus(message: string): void {
    statusEl.textContent = message;
  }

  function showError(message: string): void {
    errorEl.textContent = message;
    errorEl.classList.remove("hidden");
  }

  function clearError(): void {
    errorEl.textContent = "";
    errorEl.classList.add("hidden");
  }

  function renderSummary(cart: CartItem[], totalsData: OrderTotals): void {
    const itemsMarkup = cart
      .map(
        (item) => `
          <div class="flex justify-between text-sm">
            <span>${item.name} x${item.quantity}</span>
            <span>${formatPrice(item.priceCents * item.quantity)}</span>
          </div>
        `
      )
      .join("");

    orderSummary.innerHTML = `
      <div class="space-y-3">
        ${itemsMarkup}
      </div>
      <div class="border-t mt-4 pt-4 space-y-2 text-sm">
        <div class="flex justify-between">
          <span>Subtotal</span>
          <span>${formatPrice(totalsData.subtotalCents)}</span>
        </div>
        <div class="flex justify-between">
          <span>Shipping</span>
          <span>${totalsData.shippingCents === 0 ? "Free" : formatPrice(totalsData.shippingCents)}</span>
        </div>
        <div class="flex justify-between">
          <span>Tax</span>
          <span>${formatPrice(totalsData.taxCents)}</span>
        </div>
        <div class="flex justify-between font-bold text-primary text-lg">
          <span>Total</span>
          <span>${formatPrice(totalsData.totalCents)}</span>
        </div>
      </div>
    `;
  }

  function renderMissingData(message: string): void {
    orderSummary.innerHTML = `
      <div class="text-center py-6">
        <p class="text-text mb-4">${message}</p>
        <a href="/store/cart" class="text-primary hover:underline">Return to cart</a>
      </div>
    `;
    payButton.disabled = true;
    payButton.classList.add("opacity-60", "cursor-not-allowed");
  }

  async function createOrLoadOrder(): Promise<void> {
    const cart = getCart();
    const shipping = getShipping();

    if (!cart.length) {
      renderMissingData("Your cart is empty.");
      return;
    }

    if (!shipping) {
      renderMissingData("Shipping details are missing.");
      return;
    }

    const fingerprint = JSON.stringify({ cart, shipping });
    const savedFingerprint = sessionStorage.getItem("checkoutFingerprint");
    const savedOrderId = sessionStorage.getItem("checkoutOrderId");
    const savedTotals = sessionStorage.getItem("checkoutTotals");

    if (savedFingerprint === fingerprint && savedOrderId && savedTotals) {
      orderId = savedOrderId;
      totals = JSON.parse(savedTotals) as OrderTotals;
      renderSummary(cart, totals);
      return;
    }

    setStatus("Calculating totals...");
    const orderKey = sessionStorage.getItem("checkoutOrderKey") || crypto.randomUUID();
    sessionStorage.setItem("checkoutOrderKey", orderKey);

    const response = await fetch("/api/store/checkout", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        cartItems: cart,
        shipping,
        idempotencyKey: orderKey,
      }),
    });

    if (!response.ok) {
      const error = await response.json().catch(() => ({}));
      if (response.status === 409 && Array.isArray(error?.insufficient)) {
        const details = error.insufficient
          .map((item: { name: string; available: number }) =>
            `${item.name} (available: ${item.available})`
          )
          .join(", ");
        showError(
          `Some items are no longer in stock. Please update your cart. ${details}`
        );
        renderMissingData("Some items are out of stock. Return to cart to update.");
        return;
      }
      showError(error?.error || "Unable to calculate totals.");
      payButton.disabled = true;
      return;
    }

    const data = await response.json();
    orderId = data.orderId;
    totals = data.totals;

    sessionStorage.setItem("checkoutFingerprint", fingerprint);
    sessionStorage.setItem("checkoutOrderId", orderId);
    sessionStorage.setItem("checkoutTotals", JSON.stringify(totals));

    renderSummary(cart, totals);
    setStatus("");
  }

  async function initPayments(): Promise<void> {
    if (!appId || !locationId) {
      showError("Payment form is not configured yet. Add your Square public IDs.");
      payButton.disabled = true;
      return;
    }

    if (!(window as any).Square) {
      showError("Square payments failed to load. Refresh the page.");
      payButton.disabled = true;
      return;
    }

    const payments = (window as any).Square.payments(appId, locationId);
    card = await payments.card();
    await card.attach("#card-container");
  }

  payButton.addEventListener("click", async () => {
    clearError();
    const shipping = getShipping();

    if (!orderId || !card || !shipping) {
      showError("Checkout is not ready yet.");
      return;
    }

    payButton.disabled = true;
    setStatus("Processing payment...");

    const tokenResult = await card.tokenize();
    if (tokenResult.status !== "OK") {
      showError(tokenResult.errors?.[0]?.message || "Card tokenization failed.");
      payButton.disabled = false;
      setStatus("");
      return;
    }

    const paymentKey = sessionStorage.getItem("checkoutPaymentKey") || crypto.randomUUID();
    sessionStorage.setItem("checkoutPaymentKey", paymentKey);

    const response = await fetch("/api/store/pay", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        sourceId: tokenResult.token,
        orderId,
        buyerEmail: shipping.email,
        idempotencyKey: paymentKey,
      }),
    });

    const data = await response.json().catch(() => ({}));

    if (!response.ok) {
      showError(data?.error || "Payment failed.");
      payButton.disabled = false;
      setStatus("");
      return;
    }

    localStorage.removeItem("storeCart");
    localStorage.removeItem("checkoutShipping");
    sessionStorage.removeItem("checkoutFingerprint");
    sessionStorage.removeItem("checkoutOrderId");
    sessionStorage.removeItem("checkoutTotals");
    sessionStorage.removeItem("checkoutOrderKey");
    sessionStorage.removeItem("checkoutPaymentKey");

    const successUrl = `/store/checkout/success?orderId=${encodeURIComponent(
      data.orderId || ""
    )}&paymentId=${encodeURIComponent(data.paymentId || "")}`;
    window.location.href = successUrl;
  });

  async function init(): Promise<void> {
    await createOrLoadOrder();
    await initPayments();
  }

  init();
</script>
